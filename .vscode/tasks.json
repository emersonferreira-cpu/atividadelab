{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build raylib",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${fileDirname}/atividade9.c",
                "${fileDirname}/inventario.c",
                "${fileDirname}/entidade.c",
                "-o",
                "${fileDirname}/atividade9",
                "-lraylib",
                "-lm",
                "-lpthread",
                "-ldl",
                "-lrt",
                "-lX11"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Tarefa de compilação para o projeto com Raylib."
        }
    ],
    "version": "2.0.0"
}